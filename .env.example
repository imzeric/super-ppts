# 留空即对相应能力不提供密钥。文本密钥为空时进入演示模式。
# 不要把真实密钥写入这个文件。

AI_TEXT_BASE_URL=
AI_TEXT_API_KEY=
AI_TEXT_MODEL=
AI_VISION_BASE_URL=
AI_VISION_API_KEY=
AI_VISION_MODEL=
AI_IMAGE_BASE_URL=
AI_IMAGE_API_KEY=
AI_IMAGE_MODEL=

# 仅作为文本能力的后备
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# 可选。默认是项目下的 data/super-ppts.db
DATABASE_PATH=

# 绘制服务。本机开发时两个进程使用同一个令牌。不要提交真实令牌。
WORKER_URL=http://127.0.0.1:8080
WEB_INTERNAL_URL=http://127.0.0.1:3000
INTERNAL_SERVICE_TOKEN=
WORKER_DATABASE_PATH=data/jobs.db

# 逗号分隔。除 localhost、127.0.0.1、::1、host.docker.internal 以外，
# 要访问的内网模型主机必须写在这里，例如 192.168.1.20
TRUSTED_PROVIDER_HOSTS=
